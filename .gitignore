# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# YouTube audio saved as plain MP3s for a music playlist
/data/music-mp3

# cries downloaded while recording a card
/data/cries
/data/speech
/data/rendered
/data/demo

# Piper binary and British voice model. Tens of megabytes. Downloaded once.
/data/piper

# Bulbapedia Biology text fetched while browsing the catalogue
/data/bulbapedia

# Official artwork fetched for the Pokédex, Mega Evolutions, and Gigantamax
/data/artwork
