# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-new/
/.next-old/
/out/

# production
/build

# misc
.DS_Store

# keys and SSH files
*.pem
*.ppk
*.key
id_rsa
id_dsa
id_ed25519
id_ed25519_sk
id_ecdsa_sk
id_ecdsa
.ssh/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Cursor cloud agent setup
/.cursor/environment.json

# typescript
*.tsbuildinfo
next-env.d.ts

# YouTube audio saved as plain MP3s for a music playlist
/data/music-mp3
/data/music-youtube.json

# Deno and yt-dlp binaries from npm run deno and npm run ytdlp
/vendor/

# Python bytecode from the packaged yt-dlp
__pycache__/
*.py[cod]
/data/music-lyrics

# cries downloaded while recording a card
/data/cries
/data/speech
/data/rendered
/data/demo

# Piper binary and British voice model. Tens of megabytes. Downloaded once.
/data/piper

# Bulbapedia Biology text fetched while browsing the catalogue
/data/bulbapedia

# Official artwork fetched for the Pokédex, Mega Evolutions, and Gigantamax
/data/artwork
/data/form-pixels

# PokéAPI tables used to fill the second Pokédex line. Not the catalogue itself.
/data/poke-csv
